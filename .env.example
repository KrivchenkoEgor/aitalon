# Скопируйте в .env и заполните. .env в git не попадает (см. .gitignore).

# Ключ операторской страницы /admin — выдача и закрытие документов. Придумайте свой.
AITALON_ADMIN_KEY=

# Доступ к zro.moonmath.ai. Ключ живёт только на сервере: страница его не видит.
ZRO_API_KEY=
ZRO_BASE_URL=https://zro.moonmath.ai/v1

# Вход в Qwen. Нужен, только если сессия в qwwen/profile не живая;
# иначе браузерный источник возьмёт cookies из профиля и креды не потребуются.
QWEN_EMAIL=
QWEN_PASSWORD=

# Необязательное.
# AITALON_BASE_URL — адрес, который зашивается в QR-коды. По умолчанию имя машины
#   в локальной сети (оно не меняется, когда роутер выдаст другой IP).
# AITALON_DB — путь к базе (по умолчанию db/aitalon.db).
# AITALON_HOST — интерфейс сервера в run.sh (по умолчанию 0.0.0.0, чтобы открыть
#   чат с телефона по QR; AITALON_HOST=127.0.0.1 ./run.sh вернёт режим «только на этой машине»).
# QWEN_WINDOW=1 — показывать окно Chrome (по умолчанию скрыто).
# QWEN_CHANNEL — браузер для движка (по умолчанию chrome; "" = встроенный Chromium).
# QWEN_PROFILE — папка профиля браузера (по умолчанию qwwen/profile).
